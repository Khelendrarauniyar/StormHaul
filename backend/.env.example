DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false
CSRF_TRUSTED_ORIGINS=

# Optional.
ORS_API_KEY=

ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
WEATHER_BASE_URL=https://api.open-meteo.com
MET_NO_BASE_URL=https://api.met.no
PROVIDER_TIMEOUT_SECONDS=12
WEATHER_TIMEOUT_SECONDS=20

# Weather providers are tried in order; the fallback covers locations the
# primary could not resolve. Deadlines bound how long each provider may spend
# so a rate-limited or slow endpoint cannot stall a request.
WEATHER_PROVIDER=open-meteo
WEATHER_FALLBACK_PROVIDER=met-no
WEATHER_TOTAL_DEADLINE_SECONDS=18
WEATHER_FETCH_DEADLINE_SECONDS=12
MET_NO_WORKERS=20
MET_NO_DEADLINE_SECONDS=15

# Optional. An Open-Meteo customer key switches to the paid endpoint, which has
# higher rate limits. The free endpoint is rate limited per IP address.
OPEN_METEO_API_KEY=
